# ============================================================
# Agro Vision TN Frontend Environment Variables
# ============================================================

# Local development: use Vite's proxy to avoid browser CORS restrictions.
VITE_API_URL=/api
VITE_APP_NAME=Agro Vision TN
VITE_APP_SUBTITLE=Tamil Nadu Agriculture & Land Survey
# Google Cloud Console → APIs & Services → Credentials → Create credentials → API key.
# Enable “Maps JavaScript API”, enable billing, then restrict this browser key to:
# http://localhost:3000/* and http://127.0.0.1:3000/*
VITE_GOOGLE_MAPS_API_KEY=

# TNGIS WMS tile layer (survey boundary overlay on satellite map)
# Leave blank to disable WMS overlay — polygons will still be drawn from API data
VITE_TNGIS_WMS_URL=https://tngis.tn.gov.in/geoserver/wms
VITE_TNGIS_WMS_LAYER=tngis:survey_cadastral

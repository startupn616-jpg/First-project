# ============================================================
# AILAND Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Supabase backend connection
# 1. Open Supabase Dashboard → your project → Project Settings → API.
# 2. Copy Project URL into SUPABASE_URL.
# 3. For a local-only demo, copy the anon/publishable key into SUPABASE_ANON_KEY.
#    For deployment, use the service_role key only on the backend as SUPABASE_SERVICE_KEY.
#    Never put SUPABASE_SERVICE_KEY in frontend/.env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_KEY=your-server-only-service-role-key

# JWT Secret — generate a long random value, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ailand_gov_secret_change_this_in_production
JWT_EXPIRES_IN=8h

# File upload
UPLOAD_DIR=uploads
# DJI Neo / field photos are often 12–20 MB. 25 MB leaves safe headroom.
MAX_FILE_SIZE_MB=25

# Gemini Vision AI (server-side only)
# Create a key at https://aistudio.google.com/app/apikey. Free-tier availability,
# limits, and model access depend on the Google account and region.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite-preview-08-01

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ============================================================
# TNGIS / Tamil Nilam GEO API Configuration
# ============================================================
# Leave blank to use built-in demo/mock data for development.
# Once you receive TNGIS API access, fill in these values.

# WFS endpoint for survey polygon + attribute queries
# Default: https://tngis.tn.gov.in/geoserver/ows
TNGIS_WFS_URL=https://tngis.tn.gov.in/geoserver/ows

# REST API for A-Register / Patta details
# Default: https://eservices.tn.gov.in/eservicesnew/land
TNGIS_API_URL=https://eservices.tn.gov.in/eservicesnew/land

# API Key / Bearer token from TNGIS (leave blank to use mock data)
TNGIS_API_KEY=

# GeoServer layer name for survey cadastral data
# Default: tngis:survey_cadastral
TNGIS_LAYER=tngis:survey_cadastral

# Geometry column used by the official cadastral WFS layer for point-in-polygon lookup.
# Confirm the exact field name from TNGIS before enabling live map-to-survey resolution.
TNGIS_GEOMETRY_FIELD=geom

# ============================================================
# Frontend map environment variables (copy to frontend/.env)
# ============================================================
# WMS URL for survey boundary tile overlay on satellite map
# VITE_TNGIS_WMS_URL=https://tngis.tn.gov.in/geoserver/wms
# VITE_TNGIS_WMS_LAYER=tngis:survey_cadastral
